{
  "name": "floc-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "railway run -s floc-server -- env FLOC_LOCAL=1 NODE_ENV=development tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "create-staff": "railway run -s floc-server -- env FLOC_LOCAL=1 tsx server/scripts/create-staff.ts",
    "migrate-local": "railway run -s floc-server -- env FLOC_LOCAL=1 tsx server/scripts/migrate-local.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@turf/turf": "^7.4.0",
    "d3-contour": "^4.0.2",
    "express": "^5.3.0",
    "maplibre-gl": "^6.19.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "terra-draw": "^1.40.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
